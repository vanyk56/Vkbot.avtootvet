# ==============================================================
# Токен ВКонтакте (ОБЯЗАТЕЛЬНО: токен ПОЛЬЗОВАТЕЛЯ, не группы!)
# Получить можно через Kate Mobile / VK Admin OAuth
# ==============================================================
VK_TOKEN=vk1.a.your_token_here_xxxx

# Префикс по умолчанию для вызова команд
DEFAULT_PREFIX=нб

# ID владельца бота (число, например 123456789). Если оставить пустым, определится автоматически при запуске
OWNER_ID=

# Имя файла базы данных SQLite
DB_PATH=bot.db
